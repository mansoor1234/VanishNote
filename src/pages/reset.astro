---
import Auth from '../layouts/Auth.astro';

export const prerender = false;
---

<Auth title="Choose a new password" description="Choose a new Vanishnote password." heading="Choose a new password">
  <form class="space-y-4" data-auth-form="reset" novalidate>
    <div>
      <label for="email" class="field-label">Email</label>
      <input id="email" name="email" type="email" class="input" autocomplete="username" inputmode="email" required />
    </div>
    <div>
      <label for="password" class="field-label">New password</label>
      <input id="password" name="password" type="password" class="input" autocomplete="new-password" required minlength="10" aria-describedby="password-help" />
      <p id="password-help" class="field-hint">At least 10 characters. You’ll be signed out everywhere else.</p>
    </div>
    <div>
      <label for="confirm" class="field-label">Confirm new password</label>
      <input id="confirm" name="confirm" type="password" class="input" autocomplete="new-password" required />
    </div>
    <p class="notice-danger" role="alert" data-error hidden></p>
    <button type="submit" class="btn-primary w-full">Save new password</button>
  </form>
</Auth>

<script>
  import { initAuthForms } from '../scripts/auth';
  initAuthForms();
</script>
