---
/**
 * GET never reads or destroys the note: it only renders this shell. That keeps link-preview
 * bots (chat apps, mail scanners) from burning notes. The note is consumed when the
 * recipient presses the open button, which POSTs to /api/notes/:id/read.
 */
import BrandHeader from '../../components/BrandHeader.astro';
import Base from '../../layouts/Base.astro';
import { requestCtx } from '../../server/deps';
import { NOT_FOUND_MESSAGE } from '../../server/http';
import { loadBrand } from '../../server/team';

export const prerender = false;

// Branding comes from the link's ?b= parameter (a team's public brand id), never from the note,
// so rendering this page still doesn't reveal whether the note exists.
const ctx = requestCtx(Astro.locals, Astro.request);
const brand = await loadBrand(ctx.env.DB, Astro.url.searchParams.get('b'));
const Wrapper = brand ? 'main' : 'div';
---

<Base
  title={brand ? `A private note from ${brand.name}` : 'Someone sent you a private note'}
  description="An encrypted note that opens once. Vanishnote can't read it, and you don't need an account."
  privatePage
  ogImage="/og-note.png"
  chrome={brand ? 'none' : 'site'}
  titleSuffix={brand ? brand.name : undefined}
>
  {brand && <BrandHeader brand={brand} />}
  <Wrapper class="container-page py-10 sm:py-16" id={brand ? 'main' : undefined}>
    <!-- No aria-live here: the decrypted note must never be read aloud unprompted.
         Each state change moves focus to its heading instead. -->
    <section id="reveal" class="card mx-auto max-w-2xl">
      <noscript>
        <p class="notice-warn">
          Vanishnote needs JavaScript to decrypt notes on your device. Please enable it and reload this page.
        </p>
      </noscript>

      <div data-state="confirm">
        <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>You've received a private note</h1>
        <p class="mt-3 text-muted">
          Opening this note may destroy it for good. Make sure you're somewhere private and ready to copy what you need.
        </p>
        <p class="mt-3 text-sm text-muted">
          {
            brand
              ? `Sent securely by ${brand.name}. It's end-to-end encrypted, and you don't need an account to read it.`
              : "Vanishnote is a free tool for sending encrypted notes. We can't read this note, and you don't need an account."
          }
        </p>
        <button id="reveal-button" type="button" class="btn-primary mt-6">Open and read note</button>
      </div>

      <div data-state="missing-key" hidden>
        <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>This link is incomplete</h1>
        <p class="mt-3 text-muted">
          The part of the link after the <code class="rounded bg-surface-muted px-1">#</code> holds the decryption key,
          and it's missing or damaged. Ask the sender to copy the full link again. The note has not been opened.
        </p>
      </div>

      <div data-state="loading" hidden>
        <p class="text-muted" role="status">Opening note…</p>
      </div>

      <div data-state="password" hidden>
        <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>This note is password-protected</h1>
        <p class="notice-warn mt-4" data-password-status></p>
        <p class="mt-4 rounded-xl bg-surface-muted p-3 text-sm" data-password-hint hidden></p>
        <form id="password-form" class="mt-5 space-y-3" novalidate>
          <label for="reveal-password" class="field-label">Password</label>
          <input id="reveal-password" type="password" class="input" autocomplete="off" required />
          <p id="password-error" class="notice-danger" role="alert" hidden></p>
          <button type="submit" id="unlock-button" class="btn-primary">Unlock note</button>
        </form>
      </div>

      <div data-state="shown" hidden>
        <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>Here's your note</h1>
        <p class="mt-4" data-reads-status></p>
        <div
          id="note-content"
          class="mt-5 max-h-[60vh] overflow-auto rounded-xl border border-line bg-surface-muted p-4 font-mono text-[0.95rem] break-words whitespace-pre-wrap"
          tabindex="0"
          aria-label="Note contents"
        >
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="button" class="btn-primary" data-copy="note-content">Copy note</button>
          <span class="sr-only" aria-live="polite" data-copy-status></span>
          {!brand && <a href="/" class="btn-secondary">Write your own note</a>}
        </div>
        <div class="mt-6 rounded-xl border border-line p-4" data-attachment hidden>
          <p class="font-semibold">Attachment</p>
          <p class="mt-1 text-sm text-muted" data-attachment-name></p>
          <button type="button" class="btn-primary mt-3" data-attachment-download>Download and decrypt</button>
          <p class="mt-2 text-sm" role="status" data-attachment-status></p>
          <p class="mt-2 text-xs text-muted">The download link works once and expires in 10 minutes.</p>
        </div>
      </div>

      <div data-state="gone" hidden>
        <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>This note is gone</h1>
        <p class="mt-3">{NOT_FOUND_MESSAGE}</p>
        <p class="mt-3 text-muted">
          Notes are destroyed once they've been read or when they expire. If you weren't expecting that, tell the
          sender: someone else may have opened it first.
        </p>
        {!brand && <a href="/" class="btn-secondary mt-6">Write your own note</a>}
      </div>

      <div data-state="error" hidden>
        <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>Something went wrong</h1>
        <p class="mt-3 text-muted" data-error-message></p>
        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" class="btn-secondary" data-retry>Try again</button>
          <a href="/" class="btn-secondary" data-write-link hidden>Write a note</a>
        </div>
      </div>
    </section>
  </Wrapper>
</Base>

<script>
  import { initReveal } from '../../scripts/reveal';
  initReveal();
</script>
