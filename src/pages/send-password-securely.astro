---
import Landing from '../layouts/Landing.astro';
import type { Faq } from '../lib/schema';

const faqs: Faq[] = [
  {
    q: 'Is it safe to send a password by email?',
    a: 'Not on its own. An email sits in the sender’s and the recipient’s mailboxes, their backups and sometimes their providers’ archives, often for years. Anyone who later gets into either account finds it. A one-time link leaves only a dead link behind once it has been opened.',
  },
  {
    q: 'What about WhatsApp, Slack or Teams?',
    a: 'End-to-end encrypted chat protects the message on the way, but it stays in the chat history on every device, in backups and, for workplace tools, often in the company archive. Send the link there instead: once it has been read, the history holds nothing useful.',
  },
  {
    q: 'Can Vanishnote see the password I send?',
    a: 'No. It is encrypted in your browser before anything is sent, and the key is in the part of the link after the #, which browsers never send to us. We store only data we can’t decrypt, and delete it when it is read.',
  },
  {
    q: 'What if someone else opens the link first?',
    a: 'Then your recipient sees a message that the note is gone, and you know the link was intercepted: change the password. To protect against this, add a password to the note and tell it to the recipient another way, for example on a call.',
  },
  {
    q: 'Will a link preview in a chat app use up the note?',
    a: 'No. Previews only load the page that asks the recipient to reveal the note. The note is opened and destroyed only when a person presses the button.',
  },
  {
    q: 'Do I or the recipient need an account?',
    a: 'No. Anyone can send a note from this page and anyone with the link can open it. A free account adds a history of what you’ve sent and when it was opened.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to send a password securely',
    step: [
      { '@type': 'HowToStep', name: 'Paste the password', text: 'Paste the password into the note form. It is encrypted in your browser.' },
      { '@type': 'HowToStep', name: 'Create the link', text: 'Choose when it expires and press Create secure link.' },
      { '@type': 'HowToStep', name: 'Send the link', text: 'Send the link to your recipient. It opens once and then the note is destroyed.' },
    ],
  },
];
---

<Landing
  title="Send a password securely with a one-time link"
  description="Send a password through a link that works once and then self-destructs. Encrypted in your browser, so we can't read it. Free, no sign-up."
  eyebrow="Send a password securely"
  heading="Send a password that doesn’t stay in anyone’s inbox."
  lead="Paste the password below and send the link instead. It opens once, then the password is deleted. It’s encrypted in your browser, so we never see it."
  points={[
    'Works with email, chat or text: the link is all you send',
    'Opens once, then it’s gone from our servers',
    'Add a second password for anything important',
  ]}
  faqs={faqs}
  jsonLd={jsonLd}
>
  <h2>Why not just send it in a message?</h2>
  <p>
    Passwords sent by email or chat don’t go away. They stay in sent folders, chat histories, synced phones, backups and
    company archives, where anyone who later gets into one of those accounts can search for them. Most data breaches
    don’t need anything clever: an old message with a password in it is enough.
  </p>
  <p>
    A one-time link fixes that. What sits in the chat history is a link that has already been used. The password itself
    is gone.
  </p>

  <h2>How to send a password securely</h2>
  <ol>
    <li><strong>Paste the password</strong> into the form. Your browser encrypts it with a fresh random key.</li>
    <li>
      <strong>Choose how long it lasts</strong>: it’s deleted after it is read, or after 1 hour, 1 day or 7 days if
      nobody opens it.
    </li>
    <li><strong>Send the link</strong> by email, chat or text. The key is inside the link, after the <code>#</code>.</li>
    <li>
      <strong>Your recipient opens it</strong>, presses Reveal and copies the password. The note is destroyed on our side
      at the same moment.
    </li>
  </ol>

  <h2>For anything important, add a second password</h2>
  <p>
    Anyone who has the link can open the note once. If the link could be intercepted (a shared inbox, a forwarded email),
    set a password on the note and tell it to your recipient another way, such as on a call. They need both to read it.
    We never receive that password either. Need a good one? Use our <a href="/password-generator">password generator</a>.
  </p>

  <h2>What the recipient sees</h2>
  <p>
    A page saying they’ve received a private note, with a button to reveal it. Nothing is fetched until they press it,
    so link previews in chat apps don’t use the note up. If someone opened it first, they see that it’s gone, and you
    know to change the password.
  </p>
  <p>
    Want the details? Read <a href="/how-it-works">how it works</a> and our <a href="/security">security model</a>,
    including what it can’t protect against.
  </p>
</Landing>
