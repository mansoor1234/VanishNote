---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." privatePage>
  <div class="container-page py-16">
    <div class="prose-page">
      <h1 class="text-3xl font-bold tracking-tight">This page doesn't exist</h1>
      <p class="mt-4 text-muted">If you followed a note link, check that you copied all of it.</p>
      <p><a href="/">Write a note</a></p>
    </div>
  </div>
</Base>
