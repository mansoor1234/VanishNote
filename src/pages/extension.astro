---
/**
 * The browser extension: what it does, what it can access, and where to get it. The header's
 * "Add to Chrome" button links here until the store listings are published.
 */
import Base from '../layouts/Base.astro';
import { BROWSER_NAMES, EXTENSION_STORES, STORE_NAMES, type StoreBrowser } from '../lib/extension-store';

const stores = (Object.keys(EXTENSION_STORES) as StoreBrowser[]).map((browser) => ({
  browser,
  name: BROWSER_NAMES[browser],
  store: STORE_NAMES[browser],
  url: EXTENSION_STORES[browser],
}));
const published = stores.some((s) => s.url);

const features = [
  {
    title: 'Right-click any selected text',
    body: 'Highlight a password, key or message on any page and choose “Send as a self-destructing Vanishnote”. The link is copied for you.',
  },
  {
    title: 'One click from the toolbar',
    body: 'Write or paste a note, add an optional password, choose when it expires. No tab to open, no account needed.',
  },
  {
    title: 'Your dashboard, if you want it',
    body: 'Connect your account and notes land in your dashboard with their activity history. Your team’s policies apply automatically.',
  },
];

const faqs = [
  {
    q: 'Can the extension read the pages I visit?',
    a: 'No. It asks for no access to websites other than vanishnote.net. It only ever sees text you select and choose to send, or type into it yourself.',
  },
  {
    q: 'Is a note encrypted the same way as on the website?',
    a: 'Yes, with the same code: AES-256 in your browser, with the key in the link. We receive only scrambled data and can’t read it.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. Without one, the extension sends quick notes like our home page. With a free account you can connect it to keep a history of what you’ve sent.',
  },
  {
    q: 'Which browsers does it work in?',
    a: 'Chrome, Microsoft Edge and Firefox on desktop, plus Chromium browsers such as Brave, Opera and Vivaldi, which install from the Chrome Web Store.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Vanishnote browser extension',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Chrome, Edge, Firefox',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Send passwords and private notes as encrypted links that self-destruct after reading, from any page.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Base
  title="Browser extension"
  description="Vanishnote for Chrome, Edge and Firefox: send a password or private note from any page as an encrypted link that self-destructs after reading."
  jsonLd={jsonLd}
>
  <div class="container-page py-10 sm:py-14">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto]">
      <div class="max-w-xl">
        <p class="text-sm font-semibold tracking-wide text-accent uppercase">Free browser extension</p>
        <h1 class="mt-2 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-5xl">
          Send a secret from any page in two clicks.
        </h1>
        <p class="mt-4 text-lg text-muted">
          Select a password or paste a key, and get a link that works once and then destroys itself. Encrypted in your
          browser, so even we can’t read it.
        </p>

        <ul class="mt-8 flex flex-wrap gap-3" aria-label="Get the extension">
          {
            stores.map((s) =>
              s.url ? (
                <li>
                  <a href={s.url} target="_blank" rel="noopener" class="btn-primary data-current:ring-2 data-current:ring-accent data-current:ring-offset-2" data-store={s.browser} data-extension-cta data-browser={s.browser}>
                    Add to {s.name}
                    <span class="sr-only"> (opens the {s.store})</span>
                  </a>
                </li>
              ) : (
                <li>
                  <span class="btn-secondary cursor-default opacity-70 data-current:opacity-100" data-store={s.browser}>
                    {s.name}: coming soon
                  </span>
                </li>
              ),
            )
          }
        </ul>
        {
          !published && (
            <p class="mt-3 text-sm text-muted">
              We’re finishing the store reviews. Until then, you can send notes from the <a class="link" href="/">home page</a>.
            </p>
          )
        }
      </div>

      <picture class="mx-auto block w-full max-w-[380px] lg:mx-0">
        <source srcset="/extension-popup-dark.png" media="(prefers-color-scheme: dark)" />
        <img
          src="/extension-popup-light.png"
          width="380"
          height="600"
          alt="The Vanishnote extension popup: a note being written, with password, expiry and a Create secure link button"
          class="rounded-2xl border border-line shadow-lg"
          loading="eager"
        />
      </picture>
    </div>

    <section class="mt-20" aria-labelledby="ext-features">
      <h2 id="ext-features" class="text-2xl font-bold tracking-tight sm:text-3xl">Made for the moment you’re about to paste a password</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <div class="rounded-2xl border border-line p-6">
              <h3 class="font-semibold">{f.title}</h3>
              <p class="mt-1 text-muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-20 max-w-3xl" aria-labelledby="ext-access">
      <h2 id="ext-access" class="text-2xl font-bold tracking-tight sm:text-3xl">What it can and can’t access</h2>
      <ul class="mt-6 space-y-3">
        <li class="flex gap-3"><span aria-hidden="true" class="text-success">✓</span><span><strong>vanishnote.net only</strong>, to store the encrypted note. No other website.</span></li>
        <li class="flex gap-3"><span aria-hidden="true" class="text-success">✓</span><span><strong>The right-click menu</strong>, so it can offer to send text you’ve selected.</span></li>
        <li class="flex gap-3"><span aria-hidden="true" class="text-success">✓</span><span><strong>Its own storage</strong>, for your API key if you connect your account.</span></li>
        <li class="flex gap-3"><span aria-hidden="true" class="text-danger">✕</span><span>It can’t read or change the pages you visit, see your browsing history, or run anything on other sites.</span></li>
        <li class="flex gap-3"><span aria-hidden="true" class="text-danger">✕</span><span>No analytics, no ads, and nothing about your notes ever leaves your browser unencrypted.</span></li>
      </ul>
      <p class="mt-4 text-sm text-muted">Details in our <a class="link" href="/privacy">privacy policy</a> and <a class="link" href="/security">security model</a>.</p>
    </section>

    <section class="mt-20 max-w-3xl" aria-labelledby="ext-faq">
      <h2 id="ext-faq" class="text-2xl font-bold tracking-tight sm:text-3xl">Questions</h2>
      <div class="mt-6 space-y-3">
        {
          faqs.map(({ q, a }) => (
            <details class="group rounded-xl border border-line bg-surface p-4">
              <summary class="cursor-pointer list-none font-semibold">
                <span class="flex items-start justify-between gap-4">
                  {q}
                  <span aria-hidden="true" class="text-muted transition-transform group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-3">{a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</Base>
