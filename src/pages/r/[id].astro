---
/**
 * Respond to an information request. No account needed. The reply is encrypted in this browser
 * to the requester's public key; the link's fragment carries the key's fingerprint so a swapped
 * key is detected before anything is encrypted.
 */
import BrandHeader from '../../components/BrandHeader.astro';
import ZeroKnowledgeBadge from '../../components/ZeroKnowledgeBadge.astro';
import Base from '../../layouts/Base.astro';
import { MAX_NOTE_BYTES } from '../../lib/limits';
import { formatMB } from '../../lib/plans';
import { requestCtx } from '../../server/deps';
import { loadOpenRequest, REQUEST_GONE } from '../../server/requests';
import { loadBrand } from '../../server/team';

export const prerender = false;
const ctx = requestCtx(Astro.locals, Astro.request);
const request = await loadOpenRequest(ctx.env.DB, Astro.params.id ?? '', ctx.now);
const brand = request?.brandId ? await loadBrand(ctx.env.DB, request.brandId) : null;
const sender = brand?.name ?? request?.requester ?? 'Someone';
// Base renders <main> for the site chrome; branded pages need their own.
const Wrapper = brand ? 'main' : 'div';
---

<Base
  title="Send information securely"
  description="Someone asked you to share information securely. It’s encrypted in your browser."
  privatePage
  ogImage="/og-note.png"
  chrome={brand ? 'none' : 'site'}
  titleSuffix={brand ? brand.name : undefined}
>
  {brand && <BrandHeader brand={brand} />}
  <Wrapper class="container-page py-10 sm:py-14" id={brand ? 'main' : undefined}>
    <section id="respond" class="card mx-auto max-w-2xl" data-public-key={request?.publicKey} data-attachment-limit={request?.attachmentBytes}>
      {
        !request ? (
          <div>
            <h1 class="text-2xl font-bold tracking-tight">This request is closed</h1>
            <p class="mt-3 text-muted">{REQUEST_GONE}</p>
          </div>
        ) : (
          <>
            <div data-state="form">
              <ZeroKnowledgeBadge text={`Only ${request.requester} can read your reply`} class="mb-4" />
              <p class="text-sm font-semibold text-accent">Secure request from {sender}</p>
              <h1 class="mt-1 text-2xl font-bold tracking-tight" tabindex="-1" data-focus>
                {request.title}
              </h1>
              {request.message && <p class="mt-4 rounded-xl bg-surface-muted p-4 whitespace-pre-wrap">{request.message}</p>}
              <p class="mt-4 text-sm text-muted">
                What you send is encrypted on this device, so only {request.requester} can read it.
                {brand ? '' : ' Vanishnote can’t, and you don’t need an account.'}
              </p>

              <form class="mt-6 space-y-5" novalidate>
                <div>
                  <label for="r-text" class="field-label">
                    Your reply
                  </label>
                  <textarea id="r-text" class="input min-h-40 resize-y" autocomplete="off" spellcheck="false" aria-describedby="r-size" />
                  <p id="r-size" class="field-hint">
                    <span data-size>0 B</span> of {MAX_NOTE_BYTES / 1024} KB
                  </p>
                </div>
                <div>
                  <p class="field-label" id="r-file-label">
                    Attach a file <span class="font-normal text-muted">(optional)</span>
                  </p>
                  <label
                    class="flex min-h-24 cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-line bg-surface p-4 text-center text-sm text-muted hover:border-accent"
                    data-dropzone
                  >
                    <input type="file" class="sr-only" aria-labelledby="r-file-label" data-file-input />
                    <span class="font-semibold text-ink" data-file-name>
                      Drop a file here, or click to choose
                    </span>
                    <span data-file-detail>Encrypted before upload. Up to {formatMB(request.attachmentBytes)}.</span>
                  </label>
                  <button type="button" class="link mt-2 text-sm" data-file-clear hidden>
                    Remove file
                  </button>
                </div>
                <p class="notice-danger" role="alert" data-error hidden />
                <button type="submit" class="btn-primary" data-submit>
                  Encrypt and send
                </button>
              </form>
            </div>

            <div data-state="sent" hidden>
              <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>
                Sent securely
              </h1>
              <p class="mt-3 text-muted">
                {request.requester} has been told. Your reply can only be opened with their request password, and it’ll be
                shredded once they open it. You can close this page.
              </p>
            </div>

            <div data-state="tampered" hidden>
              <h1 class="text-2xl font-bold tracking-tight" tabindex="-1" data-focus>
                This link doesn’t match the request
              </h1>
              <p class="mt-3 text-muted">
                The security code in the link (after the #) is missing or doesn’t match. Nothing has been sent. Ask{' '}
                {request.requester} for the link again.
              </p>
            </div>
          </>
        )
      }
    </section>
  </Wrapper>
</Base>

<script>
  import { initRespond } from '../../scripts/respond';
  initRespond();
</script>
