---
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqList from '../components/FaqList.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import Prose from '../layouts/Prose.astro';
import { faqJsonLd, type Faq } from '../lib/schema';
import { CONTACT_EMAIL } from '../lib/site';

/**
 * Date of this comparison. Re-check every claim about One-Time Secret against onetimesecret.com and its GitHub repository before
 * changing it, and at least every few months.
 */
const AS_OF = 'October 2026';

const rows = [
  {
    feature: 'Where the secret is encrypted',
    ours: 'In your browser; the text never reaches our server',
    theirs: 'On their server, after your browser sends the text',
  },
  { feature: 'Free, no account needed', ours: 'Yes', theirs: 'Yes' },
  { feature: 'Destroyed after reading', ours: 'Yes', theirs: 'Yes' },
  { feature: 'Allow more than one view', ours: 'Up to 10 views', theirs: 'No, one view' },
  { feature: 'Expiry without an account', ours: 'Up to 7 days', theirs: 'Up to 7 days' },
  { feature: 'Optional password', ours: 'Yes', theirs: 'Yes (passphrase)' },
  { feature: 'Your branding', ours: 'Company name and logo (Business plan)', theirs: 'Custom domain (paid plans)' },
  { feature: 'Open source and self-hosting', ours: 'No', theirs: 'Yes (MIT licence)' },
];

const faqs: Faq[] = [
  {
    q: 'What is the main difference from One-Time Secret?',
    a: 'Where the encryption happens. Vanishnote encrypts in your browser and keeps the key in the link, so our server never receives the text. One-Time Secret receives the text and encrypts it on its server.',
  },
  {
    q: 'Can I self-host Vanishnote?',
    a: 'Not at the moment. If you need to run the service on your own servers, One-Time Secret is open source and can be self-hosted.',
  },
  {
    q: 'Is Vanishnote related to One-Time Secret?',
    a: 'No. Vanishnote is a separate, independent service.',
  },
];
---

<Prose
  title="One-Time Secret alternative: Vanishnote compared"
  description="An honest comparison of Vanishnote and One-Time Secret: where each encrypts your secret, views, expiry, passwords, files and self-hosting."
  heading="Vanishnote vs One-Time Secret"
  lead="Both give you a link to a secret that can be read once. The biggest difference is where your secret is encrypted, and so who could read it."
  jsonLd={faqJsonLd(faqs)}
>
  <h2>At a glance</h2>
  <ComparisonTable other="One-Time Secret" rows={rows} />
  <p class="text-sm text-muted">
    Comparison as of {AS_OF}, from One-Time Secret’s public information. Spotted something out of date? Email{' '}
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we’ll correct it.
  </p>

  <h2>The difference that matters most: who can read it</h2>
  <p>
    With Vanishnote, your browser encrypts the note before sending it, with a key that only exists in the link (after the{' '}
    <code>#</code>, the part browsers don’t send to servers). We store data we can’t decrypt. Nobody at Vanishnote, and
    nobody who breaks into our servers, can read it.
  </p>
  <p>
    With a service that encrypts on its server, the text arrives readable and is encrypted there. That can be done
    carefully, but it means you are trusting the server not to look, log or be compromised at the moment your secret
    passes through. Client-side encryption takes that trust out of the picture. Our <a href="/security">security model</a>{' '}
    explains the details and the limits.
  </p>

  <h2>What else Vanishnote offers</h2>
  <ul>
    <li><strong>Up to 10 views</strong>, a destroy link, and an email when the note is read.</li>
    <li><strong>Encrypted attachments</strong> and <strong>information requests</strong>, so people can send secrets to you.</li>
    <li><strong>Teams:</strong> shared notes, activity history, policies and an audit log. See <a href="/pricing">pricing</a>.</li>
    <li><strong>A browser extension</strong> for Chrome, Edge and Firefox.</li>
  </ul>

  <h2>Where One-Time Secret may suit you better</h2>
  <p>
    It’s open source and you can run it on your own servers, which some organisations require. It has also been around for
    over a decade. If self-hosting is a must, it’s a good choice.
  </p>

  <h2>Try it</h2>
  <p>Write a note on the <a href="/">home page</a>, or make a <a href="/one-time-secret-link">one-time secret link</a>.</p>

  <h2>Questions</h2>
  <FaqList faqs={faqs} />
  <RelatedGuides />
</Prose>
