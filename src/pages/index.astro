---
import CreateNote from '../components/CreateNote.astro';
import LinkAnatomy from '../components/LinkAnatomy.astro';
import WhoSeesWhat from '../components/WhoSeesWhat.astro';
import Base from '../layouts/Base.astro';

const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Vanishnote',
  url: site.href,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Any (web browser)',
  description:
    'Send encrypted notes that destroy themselves after they are read. Encryption happens in your browser, so the server never sees your message.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'AES-256-GCM encryption in the browser',
    'Burn after reading, or after up to 10 views',
    'Optional password protection',
    'Automatic expiry from 1 hour to 12 months',
    'Optional read notification by email',
  ],
};

const steps = [
  {
    title: 'Write',
    body: 'Type your secret. Your browser encrypts it with a fresh random key before anything leaves your device.',
  },
  {
    title: 'Share',
    body: 'You get a link with the key tucked after the #. Browsers never send that part to us, so we never see the key.',
  },
  {
    title: 'Vanish',
    body: 'Your recipient opens the link and presses Reveal. The note is decrypted on their device and deleted from ours.',
  },
];

const points = [
  ['Nothing readable to hand over', 'If anyone asks us for your note, all we could give them is scrambled data. We never have the key.'],
  ['Safe from link previews', 'Chat apps that preview links won’t burn your note. It opens only when a person presses Reveal.'],
  ['Nothing left behind', 'Notes are deleted on read or at expiry. No account needed, no tracking cookies, no trackers.'],
];
---

<Base
  title="Vanishnote · Self-destructing notes even we can’t read"
  description="Share passwords and private messages through a one-time link. Encrypted in your browser, so we can't read them, and destroyed after reading. Free, no sign-up."
  jsonLd={jsonLd}
>
  <div class="container-page grid gap-6 py-6 sm:gap-10 sm:py-14 lg:grid-cols-[1fr_1.15fr] lg:items-start lg:gap-14">
    <div class="lg:sticky lg:top-10">
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">Zero-knowledge encryption</p>
      <h1 class="mt-2 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-5xl">
        Notes even <span class="text-accent">we</span> can’t read.
      </h1>
      <p class="mt-3 text-lg font-semibold sm:text-xl">And they vanish once they’re read.</p>
      <!-- On small screens the composer comes first; the sections below repeat this detail. -->
      <p class="mt-4 hidden max-w-prose text-lg text-muted sm:block">
        Your note is locked in your browser before it’s sent. The only key travels inside the link you share, so our
        servers hold nothing but scrambled data, and delete it the moment it’s opened.
      </p>
      <ul class="mt-6 hidden space-y-2 text-sm sm:block">
        <li class="flex gap-2"><span aria-hidden="true" class="text-success">✓</span> We never receive your note, its key or its password</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-success">✓</span> Encrypted on your device with AES-256</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-success">✓</span> Destroyed after reading. No account needed</li>
      </ul>
    </div>
    <CreateNote />
  </div>

  <section class="container-page py-12" aria-labelledby="who-title">
    <div class="max-w-2xl">
      <h2 id="who-title" class="text-2xl font-bold tracking-tight sm:text-3xl">Readable at both ends. Scrambled in the middle.</h2>
      <p class="mt-2 text-muted">
        We’re the middle. We deliver your note without ever being able to open it. That isn’t a policy we promise to
        follow; it’s how the encryption works.
      </p>
    </div>
    <div class="mt-8">
      <WhoSeesWhat />
    </div>
    <LinkAnatomy class="mt-6" />
  </section>

  <section class="container-page py-12" aria-labelledby="steps-title">
    <h2 id="steps-title" class="text-2xl font-bold tracking-tight sm:text-3xl">Three steps, then it's gone</h2>
    <ol class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="card">
            <span class="flex size-9 items-center justify-center rounded-full bg-accent-soft font-bold text-accent" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
            <p class="mt-1 text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6"><a href="/how-it-works" class="link">See exactly how it works</a></p>
  </section>

  <section class="container-page py-12" aria-labelledby="trust-title">
    <h2 id="trust-title" class="text-2xl font-bold tracking-tight sm:text-3xl">Built so we can’t snoop, even if we wanted to</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        points.map(([title, body]) => (
          <div class="rounded-2xl border border-line p-6">
            <h3 class="font-semibold">{title}</h3>
            <p class="mt-1 text-muted">{body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6"><a href="/security" class="link">Read our security model</a></p>
  </section>
</Base>
