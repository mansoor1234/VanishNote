---
import CreateNote from '../components/CreateNote.astro';
import Base from '../layouts/Base.astro';

const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Vanishnote',
  url: site.href,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Any (web browser)',
  description:
    'Send encrypted notes that destroy themselves after they are read. Encryption happens in your browser, so the server never sees your message.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'AES-256-GCM encryption in the browser',
    'Burn after reading, or after up to 10 views',
    'Optional password protection',
    'Automatic expiry from 1 hour to 30 days',
    'Optional read notification by email',
  ],
};

const steps = [
  {
    title: 'Write',
    body: 'Type your secret. Your browser encrypts it with a fresh random key before anything leaves your device.',
  },
  {
    title: 'Share',
    body: 'You get a link with the key tucked after the #. Browsers never send that part to us, so we never see the key.',
  },
  {
    title: 'Vanish',
    body: 'Your recipient opens the link and presses Reveal. The note is decrypted on their device and deleted from ours.',
  },
];

const points = [
  ['We can’t read your notes', 'We store scrambled ciphertext only. Without the key from the link, it’s noise, even to us.'],
  ['Safe from link previews', 'Chat apps that preview links won’t burn your note. It opens only when a person presses Reveal.'],
  ['Nothing left behind', 'Notes are deleted on read or at expiry. No accounts, no cookies, no trackers.'],
];
---

<Base
  title="Vanishnote · Encrypted notes that disappear after reading"
  description="Share passwords and private messages through a one-time link. Encrypted in your browser, destroyed after reading. Free, no sign-up."
  jsonLd={jsonLd}
>
  <div class="container-page grid gap-10 py-10 sm:py-14 lg:grid-cols-[1fr_1.15fr] lg:items-start lg:gap-14">
    <div class="lg:sticky lg:top-10">
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">Private by design</p>
      <h1 class="mt-2 text-4xl leading-tight font-extrabold tracking-tight text-balance sm:text-5xl">
        Send a secret that vanishes once it's read.
      </h1>
      <p class="mt-4 max-w-prose text-lg text-muted">
        Vanishnote encrypts your message on your device and gives you a one-time link. We only ever hold scrambled
        data we can't unlock, and we delete it as soon as it's opened.
      </p>
      <ul class="mt-6 space-y-2 text-sm">
        <li class="flex gap-2"><span aria-hidden="true" class="text-accent">✓</span> End-to-end encrypted with AES-256</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-accent">✓</span> No account, no cookies, no tracking</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-accent">✓</span> Optional password and read receipts</li>
      </ul>
    </div>
    <CreateNote />
  </div>

  <section class="container-page py-12" aria-labelledby="steps-title">
    <h2 id="steps-title" class="text-2xl font-bold tracking-tight sm:text-3xl">Three steps, then it's gone</h2>
    <ol class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="card">
            <span class="flex size-9 items-center justify-center rounded-full bg-accent-soft font-bold text-accent" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
            <p class="mt-1 text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6"><a href="/how-it-works" class="link">See exactly how it works</a></p>
  </section>

  <section class="container-page py-12" aria-labelledby="trust-title">
    <h2 id="trust-title" class="text-2xl font-bold tracking-tight sm:text-3xl">Built so we can't snoop</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        points.map(([title, body]) => (
          <div class="rounded-2xl border border-line p-6">
            <h3 class="font-semibold">{title}</h3>
            <p class="mt-1 text-muted">{body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6"><a href="/security" class="link">Read our security model</a></p>
  </section>
</Base>
