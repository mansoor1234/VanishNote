---
/**
 * Free password generator. Passwords are made in the browser (lib/password.ts → crypto.ts) and
 * never sent anywhere unless the visitor sends one as a note. Handles passwords, so no
 * third-party scripts: never add this page to ANALYTICS_PATHS.
 */
import CreateNote from '../components/CreateNote.astro';
import FaqList from '../components/FaqList.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import Base from '../layouts/Base.astro';
import { DEFAULT_LENGTH, MAX_LENGTH, MIN_LENGTH } from '../lib/password';
import { faqJsonLd, type Faq } from '../lib/schema';

const sets = [
  { id: 'upper', label: 'Uppercase (A–Z)' },
  { id: 'lower', label: 'Lowercase (a–z)' },
  { id: 'digits', label: 'Numbers (0–9)' },
  { id: 'symbols', label: 'Symbols (!@#…)' },
];

const faqs: Faq[] = [
  {
    q: 'Is the password sent to your server?',
    a: 'No. It is made in your browser with the Web Crypto random number generator, and nothing on this page sends it anywhere. It only leaves your device if you choose to send it as a note, and then it is encrypted first.',
  },
  {
    q: 'How long should a password be?',
    a: 'At least 16 characters for anything that matters, and 20 or more for accounts you can’t afford to lose. Length adds more strength than symbols do. A password manager can remember it for you.',
  },
  {
    q: 'What does “avoid look-alikes” do?',
    a: 'It leaves out I, l, 1, O, o and 0, which are easy to confuse when someone reads or types the password by hand. It makes the password slightly weaker per character, so the strength shown accounts for it.',
  },
  {
    q: 'How is the strength worked out?',
    a: 'From the number of possible passwords with your settings: bits = length × log2(number of characters to choose from). Every 10 bits makes guessing about 1,000 times harder. At 80 bits or more it is out of reach of guessing, even offline with specialised hardware.',
  },
  {
    q: 'How do I give the password to someone safely?',
    a: 'Press “Send it as a self-destructing note”. You get a link that opens once, then the password is deleted. Don’t paste it into email or chat, where it stays in the history.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Vanishnote password generator',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Any (web browser)',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Generate strong random passwords in your browser and send them as self-destructing encrypted notes.',
  },
  faqJsonLd(faqs),
];
---

<Base
  title="Strong password generator, made in your browser"
  description="Generate a strong random password in your browser: nothing is sent to a server. Then share it safely as a one-time, self-destructing link. Free."
  jsonLd={jsonLd}
>
  <div class="container-page grid gap-6 py-6 sm:gap-10 sm:py-14 lg:grid-cols-[1fr_1.15fr] lg:items-start lg:gap-14">
    <div>
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">Free password generator</p>
      <h1 class="mt-2 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">
        A strong password, made on your device.
      </h1>
      <p class="mt-4 max-w-prose text-lg text-muted">
        Generated in your browser with cryptographic randomness. Nothing is sent to us. When you need to give it to someone,
        send it as a link that works once.
      </p>
    </div>

    <section id="generator" class="card" aria-labelledby="generator-title">
      <h2 id="generator-title" class="text-xl font-bold tracking-tight">Your password</h2>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row">
        <label for="generated-password" class="sr-only">Generated password</label>
        <input
          id="generated-password"
          type="text"
          readonly
          class="input font-mono text-base"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-describedby="password-strength"
        />
        <div class="flex shrink-0 gap-2">
          <button type="button" class="btn-primary flex-1" data-copy="generated-password">Copy</button>
          <button type="button" class="btn-secondary flex-1" data-regenerate>New</button>
          <span class="sr-only" aria-live="polite" data-copy-status></span>
        </div>
      </div>
      <p id="password-strength" class="field-hint" aria-live="polite" data-strength>&nbsp;</p>
      <noscript><p class="notice-warn mt-3">The generator needs JavaScript, which runs only in your browser.</p></noscript>

      <form class="mt-6 space-y-5" data-options>
        <div>
          <label for="password-length" class="field-label">
            Length: <output for="password-length" data-length-value>{DEFAULT_LENGTH}</output> characters
          </label>
          <input
            id="password-length"
            name="length"
            type="range"
            min={MIN_LENGTH}
            max={MAX_LENGTH}
            value={DEFAULT_LENGTH}
            class="w-full accent-accent"
          />
        </div>
        <fieldset>
          <legend class="field-label">Include</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {
              sets.map((set) => (
                <label class="flex min-h-11 items-center gap-3 rounded-xl border border-line px-3 text-sm">
                  <input type="checkbox" name="sets" value={set.id} checked class="size-5 accent-accent" />
                  {set.label}
                </label>
              ))
            }
          </div>
          <label class="mt-2 flex min-h-11 items-center gap-3 rounded-xl border border-line px-3 text-sm">
            <input type="checkbox" name="avoidLookAlikes" class="size-5 accent-accent" />
            Avoid look-alikes (I l 1 O o 0)
          </label>
          <p class="field-hint" data-sets-error hidden>Choose at least one kind of character.</p>
        </fieldset>
      </form>

      <div class="mt-6 border-t border-line pt-6">
        <button type="button" class="btn-secondary w-full" data-send-note>Send it as a self-destructing note</button>
        <p class="field-hint">Puts the password in the note form below. It’s encrypted before it leaves your browser.</p>
      </div>
    </section>
  </div>

  <div class="container-page pb-6">
    <div class="mx-auto max-w-3xl">
      <CreateNote />
    </div>
  </div>

  <article class="container-page pb-6">
    <div class="prose-page">
      <h2>What makes a password strong</h2>
      <p>
        Length and randomness. A password a person makes up follows patterns that guessing tools try first: words, names,
        dates, a capital at the start and a number at the end. A random 20-character password from this page has well over
        100 bits of strength, more than any attacker can guess.
      </p>
      <ul>
        <li><strong>Use a different password for every account</strong>, so one leak doesn’t unlock the rest.</li>
        <li><strong>Keep it in a password manager</strong> rather than memorising or writing it down.</li>
        <li><strong>Turn on two-factor sign-in</strong> where the site offers it.</li>
      </ul>

      <h2>Sharing it without leaving a copy behind</h2>
      <p>
        Setting up an account for someone else, or handing over a shared login? Don’t send the password by email or chat,
        where it stays in the history. Send it as a one-time note: they open the link once, and it’s gone. Read more about{' '}
        <a href="/send-password-securely">sending a password securely</a>.
      </p>

      <h2>Questions</h2>
      <FaqList faqs={faqs} />
    </div>
    <RelatedGuides />
  </article>
</Base>

<script>
  import { initPasswordGenerator } from '../scripts/password-generator';
  initPasswordGenerator();
</script>
