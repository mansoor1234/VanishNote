---
/**
 * Team admin for owners on Standard and Business: policies, members' live notes, audit log.
 * Free (and members) see what it offers and how to get it.
 */
import SettingsCard from '../../components/app/SettingsCard.astro';
import App from '../../layouts/App.astro';
import { TIMED_EXPIRY_DAYS, TIMED_EXPIRY_LABELS, type TimedExpiry } from '../../lib/limits';
import { formatRetention, PLANS } from '../../lib/plans';
import { AUDIT_ACTIONS, listAudit } from '../../server/audit';
import { requestCtx } from '../../server/deps';

export const prerender = false;
const user = Astro.locals.user!;
const plan = PLANS[user.plan];
const ctx = requestCtx(Astro.locals, Astro.request);
const isOwner = user.role === 'owner';
const enabled = isOwner && plan.limits.teamAdmin;

const actorParam = Astro.url.searchParams.get('person');
const actor = actorParam && /^[A-Za-z0-9_-]{1,64}$/.test(actorParam) ? actorParam : null;

const members = enabled
  ? (
      await ctx.env.DB.prepare(
        `SELECT u.id, u.name, u.email, u.role,
                (SELECT COUNT(*) FROM records r JOIN notes n ON n.id = r.id WHERE r.team_id = ?1 AND r.user_id = u.id) AS live_notes,
                (SELECT COUNT(*) FROM records r JOIN requests q ON q.id = r.id WHERE r.team_id = ?1 AND r.user_id = u.id) AS open_requests
           FROM users u WHERE u.team_id = ?1 ORDER BY u.role = 'owner' DESC, u.name`,
      )
        .bind(user.teamId)
        .all<{ id: string; name: string; email: string; role: string; live_notes: number; open_requests: number }>()
    ).results
  : [];
const entries = enabled ? await listAudit(ctx.env.DB, user.teamId, { limit: 100, actorId: actor }) : [];

// Policy form: only lifetimes shorter than the plan's retention are meaningful limits.
const lifetimes = (Object.keys(TIMED_EXPIRY_DAYS) as TimedExpiry[]).filter((k) => TIMED_EXPIRY_DAYS[k] < plan.limits.retentionDays);
const shieldIcon = 'M12 3l7 3v6c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V6zM9 12l2 2 4-4';
const peopleIcon = 'M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19M10 10.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7';
const logIcon = 'M9 5h11M9 12h11M9 19h11M4 5h.01M4 12h.01M4 19h.01';
---

<App title="Admin & audit log">
  <div class="mx-auto max-w-4xl space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Admin & audit log</h1>
      <p class="text-sm text-muted">Set rules for everything your team sends, and see who did what.</p>
    </div>

    {
      !enabled ? (
        <section class="card" aria-labelledby="admin-upsell">
          <h2 id="admin-upsell" class="text-lg font-bold">
            {isOwner ? 'Team admin is included in Standard and Business' : 'Only the team owner can use admin tools'}
          </h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
            <li>Require a password on every note, and cap how long notes and requests can live.</li>
            <li>An audit log of sign-ins, notes, requests and team changes, with CSV export.</li>
            <li>Shred everything a team member has sent with one click, for example when they leave.</li>
            <li>On Business: require everyone to sign in with Google or Microsoft.</li>
          </ul>
          {isOwner && (
            <p class="mt-4">
              <a href="/app/subscription" class="btn-primary">See plans</a>
            </p>
          )}
        </section>
      ) : (
        <>
          <SettingsCard id="policies" title="Team policies" subtitle="The server enforces these on every note and request your team creates, including from the API and the browser extension." icon={shieldIcon}>
            <form class="space-y-5" data-form="policy" novalidate>
              <label class="flex items-start gap-3">
                <input type="checkbox" name="requirePassword" class="mt-1 size-4" checked={user.policy.requirePassword} />
                <span>
                  <span class="font-semibold">Require a password on every note</span>
                  <span class="block text-sm text-muted">Protects notes if a link is forwarded or intercepted. Recipients get the password a different way.</span>
                </span>
              </label>
              <div>
                <label for="p-expiry" class="field-label">Longest a note or request can live</label>
                <select id="p-expiry" name="maxExpiry" class="input sm:max-w-xs">
                  <option value="" selected={user.policy.maxExpiry === null}>No limit ({formatRetention(plan.limits.retentionDays)}, your plan’s maximum)</option>
                  {lifetimes.map((k) => <option value={k} selected={user.policy.maxExpiry === k}>{TIMED_EXPIRY_LABELS[k]}</option>)}
                </select>
                <p class="field-hint">Unread notes and unanswered requests are shredded after this.</p>
              </div>
              <label class:list={['flex items-start gap-3', !plan.limits.ssoEnforcement && 'opacity-60']}>
                <input type="checkbox" name="requireSso" class="mt-1 size-4" checked={user.policy.requireSso} disabled={!plan.limits.ssoEnforcement} />
                <span>
                  <span class="font-semibold">Members must sign in with Google or Microsoft</span>
                  <span class="block text-sm text-muted">
                    {plan.limits.ssoEnforcement
                      ? 'Members can’t use a password to sign in. You, the owner, always can, so you can’t be locked out.'
                      : 'Included in Business.'}
                  </span>
                </span>
              </label>
              <p role="status" class="text-sm" data-result></p>
              <button type="submit" class="btn-primary">Save policies</button>
            </form>
          </SettingsCard>

          <SettingsCard id="members-notes" title="Members’ live notes" subtitle="Shred everything a person has sent that is still waiting to be read or answered." icon={peopleIcon}>
            <ul class="divide-y divide-line">
              {members.map((m) => (
                <li class="flex flex-wrap items-center gap-3 py-3">
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold">{m.name}{m.id === user.id && <span class="font-normal text-muted"> (you)</span>}</p>
                    <p class="text-sm text-muted">
                      {m.live_notes} live {m.live_notes === 1 ? 'note' : 'notes'} · {m.open_requests} open {m.open_requests === 1 ? 'request' : 'requests'}
                    </p>
                  </div>
                  <a href={`/app?member=${m.id}`} class="btn-secondary min-h-9 py-1.5 text-sm">View</a>
                  <button
                    type="button"
                    class="btn-secondary min-h-9 py-1.5 text-sm text-danger"
                    data-shred-member={m.id}
                    data-name={m.name}
                    disabled={m.live_notes + m.open_requests === 0}
                  >
                    Shred all
                  </button>
                </li>
              ))}
            </ul>
            <p role="status" class="mt-2 text-sm" data-shred-status></p>
          </SettingsCard>

          <SettingsCard id="audit" title="Audit log" subtitle={`Sign-ins, notes, requests and team changes. Kept for ${formatRetention(plan.limits.retentionDays)}. Never note contents.`} icon={logIcon}>
            <div class="flex flex-wrap items-end justify-between gap-3">
              <form method="get" class="flex items-end gap-2">
                <div>
                  <label for="a-person" class="field-label">Person</label>
                  <select id="a-person" name="person" class="input min-h-10 py-1.5" data-auto-submit>
                    <option value="">Everyone</option>
                    {members.map((m) => <option value={m.id} selected={actor === m.id}>{m.name}</option>)}
                  </select>
                </div>
                <noscript><button type="submit" class="btn-secondary">Filter</button></noscript>
              </form>
              <a href="/api/account/team/audit.csv" class="btn-secondary" download>Export CSV</a>
            </div>
            {entries.length === 0 ? (
              <p class="mt-4 text-sm text-muted">Nothing recorded yet.</p>
            ) : (
              <div class="mt-4 overflow-x-auto">
                <table class="w-full text-left text-sm">
                  <caption class="sr-only">Latest {entries.length} audit log entries</caption>
                  <thead class="text-xs text-muted uppercase">
                    <tr>
                      <th scope="col" class="py-2 pr-3 font-semibold">When</th>
                      <th scope="col" class="py-2 pr-3 font-semibold">Who</th>
                      <th scope="col" class="py-2 pr-3 font-semibold">What</th>
                      <th scope="col" class="py-2 font-semibold">Where</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line">
                    {entries.map((e) => (
                      <tr>
                        <td class="py-2 pr-3 whitespace-nowrap text-muted">
                          <time datetime={new Date(e.created_at).toISOString()} data-local-time>{new Date(e.created_at).toUTCString()}</time>
                        </td>
                        <td class="py-2 pr-3 font-medium">{e.actor_name}</td>
                        <td class="py-2 pr-3">
                          {AUDIT_ACTIONS[e.action] ?? e.action}
                          {e.target && <span class="text-muted"> {e.action === 'user.signed_in' ? `(${e.target})` : `“${e.target}”`}</span>}
                        </td>
                        <td class="py-2 text-muted">{e.country ?? '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {entries.length === 100 && <p class="mt-2 text-xs text-muted">Showing the latest 100. Export the CSV for everything.</p>}
              </div>
            )}
          </SettingsCard>
        </>
      )
    }
  </div>
</App>

<script>
  import { initAdmin } from '../../scripts/app/admin';
  initAdmin();
</script>
