---
import App from '../../layouts/App.astro';
import { CONTACT_EMAIL } from '../../lib/site';

export const prerender = false;
const subject = (Astro.url.searchParams.get('subject') ?? '').slice(0, 150);
---

<App title="Contact">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold tracking-tight">Contact us</h1>
    <p class="text-sm text-muted">We usually reply within one business day. Never send passwords or note links here.</p>
    <section class="card mt-6">
      <form class="space-y-4" data-form="contact" novalidate>
        <div>
          <label for="c-subject" class="field-label">Subject</label>
          <input id="c-subject" name="subject" class="input" required maxlength="150" value={subject} />
        </div>
        <div>
          <label for="c-message" class="field-label">Message</label>
          <textarea id="c-message" name="message" class="input min-h-40" required maxlength="5000"></textarea>
        </div>
        <p role="status" class="text-sm" data-result></p>
        <button type="submit" class="btn-primary">Send message</button>
      </form>
      <p class="mt-4 text-sm text-muted">Or email <a class="link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    </section>
  </div>
</App>

<script>
  import { initContact } from '../../scripts/app/settings';
  initContact();
</script>
