---
import { getCollection, render } from 'astro:content';
import RelatedGuides from '../../components/RelatedGuides.astro';
import Prose from '../../layouts/Prose.astro';
import ogManifest from '../../lib/og-manifest.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
const site = Astro.site ?? new URL('https://vanishnote.net');
const path = `/blog/${post.id}`;
const url = new URL(path, site).href;
const image = new URL((ogManifest as Record<string, { image: string }>)[path]?.image ?? '/og.png', site).href;
const others = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const organization = { '@type': 'Organization', '@id': `${site.origin}/#organization`, name: 'Vanishnote', url: `${site.origin}/`, logo: `${site.origin}/icon-512.png` };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image,
  datePublished: post.data.published.toISOString(),
  dateModified: (post.data.updated ?? post.data.published).toISOString(),
  mainEntityOfPage: url,
  url,
  inLanguage: 'en',
  author: organization,
  publisher: organization,
};
---

<Prose
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  heading={post.data.title}
  jsonLd={jsonLd}
  ogType="article"
  breadcrumb={post.data.seoTitle ?? post.data.title}
>
  <p slot="before-heading" class="mb-3! text-sm">
    <a href="/blog">← All posts</a>
    <span class="text-muted"> · </span>
    <time class="text-muted" datetime={post.data.published.toISOString()}>{dateFormat.format(post.data.published)}</time>
    {
      post.data.updated && (
        <>
          <span class="text-muted"> · updated </span>
          <time class="text-muted" datetime={post.data.updated.toISOString()}>{dateFormat.format(post.data.updated)}</time>
        </>
      )
    }
  </p>
  <Content />
  <aside class="mt-10 rounded-2xl bg-surface-muted p-6">
    <p class="mb-3! font-semibold">Need to send something sensitive right now?</p>
    <a href="/" class="btn-primary">Write an encrypted note</a>
  </aside>
  {
    others.length > 0 && (
      <section aria-labelledby="more-posts" class="mt-12">
        <h2 id="more-posts">More from the blog</h2>
        <ul>
          {others.map((p) => (
            <li>
              <a href={`/blog/${p.id}`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <RelatedGuides posts={false} />
</Prose>
