---
import { getCollection, render } from 'astro:content';
import Prose from '../../layouts/Prose.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
const url = new URL(`/blog/${post.id}`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  dateModified: (post.data.updated ?? post.data.published).toISOString(),
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: 'Vanishnote' },
  publisher: { '@type': 'Organization', name: 'Vanishnote' },
};
---

<Prose title={post.data.title} description={post.data.description} heading={post.data.title} jsonLd={jsonLd} ogType="article">
  <p slot="before-heading" class="mb-3! text-sm">
    <a href="/blog">← All posts</a>
    <span class="text-muted"> · </span>
    <time class="text-muted" datetime={post.data.published.toISOString()}>{dateFormat.format(post.data.published)}</time>
  </p>
  <Content />
  <aside class="mt-10 rounded-2xl bg-surface-muted p-6">
    <p class="mb-3! font-semibold">Need to send something sensitive right now?</p>
    <a href="/" class="btn-primary">Write an encrypted note</a>
  </aside>
</Prose>
