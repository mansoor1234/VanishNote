---
import Auth from '../layouts/Auth.astro';

export const prerender = false;
---

<Auth title="Log in" description="Log in to your Vanishnote dashboard." heading="Welcome back" privatePage={false}>
  <form class="space-y-4" data-auth-form="login" novalidate>
    <div>
      <label for="email" class="field-label">Email</label>
      <input id="email" name="email" type="email" class="input" autocomplete="username" inputmode="email" required />
    </div>
    <div>
      <div class="flex items-baseline justify-between">
        <label for="password" class="field-label">Password</label>
        <a href="/forgot" class="text-sm link">Forgot it?</a>
      </div>
      <div class="flex gap-2">
        <input id="password" name="password" type="password" class="input" autocomplete="current-password" required />
        <button type="button" class="btn-secondary shrink-0 px-3" data-toggle-password="password" aria-pressed="false">Show</button>
      </div>
    </div>
    <p class="notice-danger" role="alert" data-error hidden></p>
    <button type="submit" class="btn-primary w-full">Log in</button>
  </form>
  <hr class="my-6 border-line" />
  <p class="text-center text-sm text-muted">New here? <a class="link" href="/signup">Create a free account</a></p>
</Auth>

<script>
  import { initAuthForms } from '../scripts/auth';
  initAuthForms();
</script>
