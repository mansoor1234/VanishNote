---
/**
 * Vanishnote mark: a V whose right stroke breaks into drifting fragments.
 * Decorative by default; the wordmark text sits beside it as real text.
 * Source: src/assets/logo-mark.svg (also copied to public/favicon.svg by scripts/generate-og.mjs).
 */
import mark from '../assets/logo-mark.svg?raw';

interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
// Gradient and clip ids must be unique if the mark appears more than once on a page.
const uid = Math.random().toString(36).slice(2, 8);
const svg = mark
  .trim()
  .replace(/vn-([abc])/g, `vn-$1-${uid}`)
  .replace(
    '<svg ',
    `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''} `,
  );
---

<Fragment set:html={svg} />
