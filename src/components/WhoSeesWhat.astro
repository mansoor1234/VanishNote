---
/** The core idea as a picture: your note is readable at both ends and only scrambled in the middle (us). */
const sample = 'Wi-Fi password: blue-harbor-42';
const scrambled = '7xQ2fKpL9vR3mN8wE1aT6bY0cU5dJ4hG2sZ9iO7kF3lP1qX8eV6rW0tA5yS';
const lock = 'M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4';
const eyeOff =
  'M17.9 17.9A10 10 0 0 1 12 20c-7 0-10-8-10-8a18.4 18.4 0 0 1 5.1-5.9M9.9 4.2A9 9 0 0 1 12 4c7 0 10 8 10 8a18.5 18.5 0 0 1-2.2 3.2M14.1 14.1a3 3 0 1 1-4.2-4.2M2 2l20 20';
const device = 'M5 4h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zM8 20h8M12 16v4';
---

<ol class="grid gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:items-stretch">
  <li class="card flex flex-col">
    <p class="flex items-center gap-2 text-sm font-semibold text-muted">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={device}></path></svg>
      Your device
    </p>
    <h3 class="mt-2 text-lg font-bold">You write it</h3>
    <p class="mt-3 rounded-xl bg-surface-muted p-3 font-mono text-sm">{sample}</p>
    <p class="mt-3 text-sm text-muted">Your browser locks it with a brand-new random key before anything is sent.</p>
  </li>

  <li class="hidden items-center text-2xl text-muted lg:flex" aria-hidden="true">→</li>

  <li class="flex flex-col rounded-2xl border-2 border-dashed border-line bg-surface-muted/60 p-5 sm:p-8">
    <p class="flex items-center gap-2 text-sm font-semibold text-muted">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={eyeOff}></path></svg>
      Our servers
    </p>
    <h3 class="mt-2 text-lg font-bold">We can’t read it</h3>
    <p class="mt-3 rounded-xl bg-surface p-3 font-mono text-sm break-all text-muted" aria-label="Scrambled, unreadable data">
      {scrambled}…
    </p>
    <ul class="mt-3 space-y-1 text-sm">
      <li class="flex gap-2"><span class="font-bold text-danger" aria-hidden="true">✕</span> No key</li>
      <li class="flex gap-2"><span class="font-bold text-danger" aria-hidden="true">✕</span> No password</li>
      <li class="flex gap-2"><span class="font-bold text-danger" aria-hidden="true">✕</span> No way to unscramble it</li>
    </ul>
  </li>

  <li class="hidden items-center text-2xl text-muted lg:flex" aria-hidden="true">→</li>

  <li class="card flex flex-col">
    <p class="flex items-center gap-2 text-sm font-semibold text-muted">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={lock}></path></svg>
      Your recipient
    </p>
    <h3 class="mt-2 text-lg font-bold">They unlock it</h3>
    <p class="mt-3 rounded-xl bg-surface-muted p-3 font-mono text-sm">{sample}</p>
    <p class="mt-3 text-sm text-muted">The key in their link unlocks it on their device. Then it’s deleted from ours.</p>
  </li>
</ol>
