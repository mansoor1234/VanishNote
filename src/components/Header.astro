---
import { cleanPath } from '../lib/site';
import Logo from './Logo.astro';

const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/security', label: 'Security' },
  { href: '/faq', label: 'FAQ' },
  { href: '/blog', label: 'Blog' },
];
const current = cleanPath(Astro.url.pathname);
---

<header class="border-b border-line/70">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 py-2 sm:py-3">
    <a href="/" class="flex min-h-11 items-center gap-2 rounded-lg text-ink" aria-label="Vanishnote home">
      <Logo class="text-accent" />
      <span class="text-lg font-bold tracking-tight">vanish<span class="text-muted">note</span></span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-3 text-sm font-medium sm:gap-x-4">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'inline-flex min-h-11 items-center rounded px-1 hover:text-accent',
                  current === href || current.startsWith(`${href}/`) ? 'text-accent' : 'text-muted',
                ]}
                aria-current={current === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
