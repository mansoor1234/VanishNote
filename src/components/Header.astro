---
import { cleanPath } from '../lib/site';
import Logo from './Logo.astro';

const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/security', label: 'Security' },
  { href: '/faq', label: 'FAQ' },
  { href: '/blog', label: 'Blog' },
];
const current = cleanPath(Astro.url.pathname);
---

<header class="border-b border-line/70">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 py-2 sm:py-3">
    <a href="/" class="flex min-h-11 items-center gap-2 rounded-lg text-ink" aria-label="Vanishnote home">
      <Logo size={32} />
      <span class="text-lg font-extrabold tracking-tight">Vanishnote</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-3 text-sm font-medium sm:gap-x-4">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'inline-flex min-h-11 items-center rounded px-1 hover:text-accent',
                  current === href || current.startsWith(`${href}/`) ? 'text-accent' : 'text-muted',
                ]}
                aria-current={current === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/login" class="inline-flex min-h-11 items-center rounded px-1 text-muted hover:text-accent">Log in</a>
        </li>
        <li>
          <!-- Compact: min-h-9 overrides the base button's 44px minimum in the header. -->
          <a href="/signup" class="btn-primary min-h-9 rounded-lg px-4 py-1 text-sm">Sign up free</a>
        </li>
        <li class="hidden lg:list-item">
          <a
            href="/extension"
            class="btn-secondary min-h-9 gap-1.5 rounded-lg px-3 py-1 text-sm"
            aria-current={current === '/extension' ? 'page' : undefined}
            data-extension-cta
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path>
            </svg>
            <span data-label>Get the extension</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initExtensionCta } from '../scripts/extension-cta';
  initExtensionCta();
</script>
