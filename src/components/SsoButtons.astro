---
/**
 * "Continue with Google / Microsoft" for the log-in and sign-up pages. Plain links to our start
 * endpoint (top-level navigation, so the CSP's form-action and connect-src don't apply). Only the
 * providers configured on this server are shown.
 */
import { requestCtx } from '../server/deps';
import { enabledProviders, PROVIDERS, SSO_ERRORS, type Provider } from '../server/sso';

interface Props {
  mode: 'login' | 'signup';
}
const { mode } = Astro.props;
const ctx = requestCtx(Astro.locals, Astro.request);
const providers = enabledProviders(ctx.env);
const next = Astro.url.searchParams.get('next');
const errorCode = Astro.url.searchParams.get('sso_error');
const message = errorCode ? (SSO_ERRORS[errorCode] ?? SSO_ERRORS['failed']) : null;

function href(provider: Provider): string {
  const params = new URLSearchParams({ mode });
  if (next) params.set('next', next);
  // The notice under the buttons says that continuing accepts the terms (recorded with the version).
  if (mode === 'signup') params.set('terms', '1');
  return `/api/auth/sso/${provider}/start?${params}`;
}
---

{message && <p class="notice-danger mb-4" role="alert">{message}</p>}
{
  providers.length > 0 && (
    <div class="space-y-2" data-sso={mode}>
      {providers.map((p) => (
        <a href={href(p)} class="btn-secondary w-full gap-3" data-sso-provider={p}>
          {p === 'google' ? (
            <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </svg>
          ) : (
            <svg width="18" height="18" viewBox="0 0 23 23" aria-hidden="true">
              <path fill="#f25022" d="M1 1h10v10H1z" />
              <path fill="#00a4ef" d="M1 12h10v10H1z" />
              <path fill="#7fba00" d="M12 1h10v10H12z" />
              <path fill="#ffb900" d="M12 12h10v10H12z" />
            </svg>
          )}
          {mode === 'signup' ? 'Sign up' : 'Continue'} with {PROVIDERS[p].name}
        </a>
      ))}
      {mode === 'signup' && (
        <p class="text-xs text-muted">
          By continuing with Google or Microsoft you agree to the <a class="link" href="/terms" target="_blank" rel="noopener">terms of use</a> and{' '}
          <a class="link" href="/privacy" target="_blank" rel="noopener">privacy policy</a>. We only receive your name and email address.
        </p>
      )}
      <div class="flex items-center gap-3 py-2 text-xs text-muted" aria-hidden="true">
        <span class="h-px flex-1 bg-line"></span>or {mode === 'signup' ? 'sign up' : 'log in'} with email<span class="h-px flex-1 bg-line"></span>
      </div>
    </div>
  )
}
