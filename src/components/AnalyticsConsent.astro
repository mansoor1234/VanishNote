---
/** Opt-in banner for Google Analytics. Rendered by Base.astro on ANALYTICS_PATHS only. */
---

<section
  class="card fixed inset-x-4 bottom-4 z-40 mx-auto max-w-xl p-4! shadow-lg sm:p-5!"
  aria-labelledby="consent-title"
  data-consent-banner
  hidden
>
  <h2 id="consent-title" class="font-semibold">Help us improve these pages?</h2>
  <p class="mt-1 text-sm text-muted">
    With your OK, we use Google Analytics on our information pages, like this one, to see which are useful. It
    never runs where you write or read notes. <a href="/privacy#analytics" class="link">Details</a>
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" class="btn-primary" data-consent-accept>Allow analytics</button>
    <button type="button" class="btn-secondary" data-consent-decline>No thanks</button>
  </div>
</section>

<script>
  import { initAnalytics } from '../scripts/analytics';
  initAnalytics();
</script>
