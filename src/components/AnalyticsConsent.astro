---
/**
 * Opt-in banner for Google Analytics. Rendered by Base.astro on ANALYTICS_PATHS only.
 * Uses the banner colours (deep indigo) so it stands out from the page in both themes.
 */
---

<section
  class="fixed inset-x-4 bottom-4 z-40 mx-auto max-w-xl rounded-2xl border border-banner-line bg-banner-bg p-4 text-banner-ink shadow-2xl shadow-black/30 sm:p-5"
  aria-labelledby="consent-title"
  data-consent-banner
  hidden
>
  <div class="flex items-start gap-3">
    <span class="mt-0.5 hidden size-9 shrink-0 items-center justify-center rounded-xl bg-white/15 sm:flex" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 3v18h18M7 15l4-4 3 3 5-6"></path>
      </svg>
    </span>
    <div class="min-w-0">
      <h2 id="consent-title" class="font-semibold">Help us improve these pages?</h2>
      <p class="mt-1 text-sm text-banner-muted">
        With your OK, we use Google Analytics on our information pages, like this one, to see which are useful. It
        never runs where you write or read notes.{' '}
        <a href="/privacy#analytics" class="font-medium text-banner-ink underline underline-offset-4 focus-visible:outline-white">Details</a>
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="btn bg-banner-action text-banner-action-ink hover:opacity-90 focus-visible:outline-white" data-consent-accept>Allow analytics</button>
        <button type="button" class="btn border border-banner-line text-banner-ink hover:bg-white/10 focus-visible:outline-white" data-consent-decline>No thanks</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initAnalytics } from '../scripts/analytics';
  initAnalytics();
</script>
