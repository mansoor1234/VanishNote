{
  "name": "vanishnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted, self-destructing notes.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply vanishnote --local",
    "db:migrate:remote": "wrangler d1 migrations apply vanishnote --remote",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
